appSCPHelmPipelineRefs:
  helmChartRepo: "{{ .Values.helm_chart_repo_forwardslash_name }}"
  helmChartVersion: "{{ .Values.helm_chart_version }}"
  projectOverlayFilesRef: "{{ .Values.project_overlay_files_ref }}"
  deploymentDateTimeStamp: "{{ now }}"
  deploymentFromGithubRepo: '{{ requiredEnv "GITHUB_REPOSITORY" }}'
  deploymentGitHubAction: '{{ requiredEnv "GITHUB_ACTION" }}'
  deploymentRepoBranch: '{{ requiredEnv "GITHUB_REF_NAME" }}'
  deploymentByGithubTriggeringActor: '{{ requiredEnv "GITHUB_TRIGGERING_ACTOR" }}'
  deploymentGithubRunAttempt: '{{ requiredEnv "GITHUB_RUN_ATTEMPT" }}'
  deploymentGithubRunnerEnv: '{{ requiredEnv "RUNNER_ENVIRONMENT" }}'
  deploymentGithubRunnerName: '{{ requiredEnv "RUNNER_NAME" }}'

global:
  ACR_PASSWORD: '{{ env "CLOUDHUB_PASSWORD" }}'
  ACR_USER: '{{ env "CLOUDHUB_USERNAME" }}'
  DATA_EXPLORER_ENABLED: "False"
  ENV_TYPE: "{{ .Values.envType }}" 
  EUREKA_THRIFT_URL: ""
  HELM_INIT_DB: true
  K8S_TYPE: "azure"
  KEYCLOAK_REALM: "{{ .Values.namespace }}"
  OKTA_ENABLED: false
  SYSTEM_AZURE_STORAGE_CONTAINER_NAME: "workflows-container"
  TLS_CERT: {{- if eq .Values.domain_name_cloud_or_dev "cloud" }}
    '{{ env "CLOUDHUB_BASE64__CRT" }}'
  {{- else if eq .Values.domain_name_cloud_or_dev "dev" }}
    '{{ env "CLOUDHUB_BASE64__CRT" }}'
  {{- end }}

  TLS_KEY: {{- if eq .Values.domain_name_cloud_or_dev "cloud" }}
    '{{ env "CLOUDHUB_BASE64__KEY" }}'
  {{- else if eq .Values.domain_name_cloud_or_dev "dev" }}
    '{{ env "CLOUDHUB_BASE64__KEY" }}'
  {{- end }}

# Orchestrator API Configuration
orchestratorapi:
  CERT: ".crt"
  KEY: ".key"

# Workflow Worker Configuration
workflowworker:
  TEMPORAL_SELF_HOSTED: "true"
  TEMPORAL_CLOUD:
    TEMPORAL_ADDRESS: :7233
    TEMPORAL_NAMESPACE: 

ingressurl:
  arizephoenix: "{{ .Values.namespace }}-arizephoenix.symphonyai.{{ .Values.domain_name_cloud_or_dev }}"
  canvasui: "{{ .Values.namespace }}-workflows.symphonyai.{{ .Values.domain_name_cloud_or_dev }}"
  grafana: "{{ .Values.namespace }}-grafana.symphonyai.{{ .Values.domain_name_cloud_or_dev }}"
  keycloak: "{{ .Values.namespace }}-keycloak.symphonyai.{{ .Values.domain_name_cloud_or_dev }}"
  litellm: "{{ .Values.namespace }}-litellm.symphonyai.{{ .Values.domain_name_cloud_or_dev }}"
  tcm: "{{ .Values.namespace }}-tcm.symphonyai.{{ .Values.domain_name_cloud_or_dev }}"
  temporal: "{{ .Values.namespace }}-temporal.symphonyai.{{ .Values.domain_name_cloud_or_dev }}"

# Keycloak Configuration
keycloak:
  replicaCount: 1
  enabled: true

  image:
    pullSecrets:
      - name: regcred

  keycloakConfigCli:
    image:
      pullSecrets:
        - name: regcred
  auth:
    createAdminUser: true
  ingress:
    hostname: "{{ .Values.namespace }}-keycloak.symphonyai.{{ .Values.domain_name_cloud_or_dev }}"
    extraTls:
      - secretName: ingress-tls-secret
        hosts:
          - "{{ .Values.namespace }}-keycloak.symphonyai.{{ .Values.domain_name_cloud_or_dev }}"

# Temporal Configuration
temporal:
  enabled: true
  
  imagePullSecrets:
    - name: regcred
  tolerations: []
  postgresql:
    tls:
      enabled: true
      enableHostVerification: false
  server:
    nodeSelector: null
    tolerations: []
    config:
      persistence:
        default:
          driver: "sql"
          sql:
            driver: "postgres12"
            port: 5432
            tls:
              enabled: true
              enableHostVerification: false
        visibility:
          driver: "sql"
          sql:
            driver: "postgres12"
            port: 5432
            tls:
              enabled: true
              enableHostVerification: false
  frontend:
    nodeSelector: null
    tolerations: []
  internalFrontend:
    nodeSelector: null
    tolerations: []
  history:
    nodeSelector: null
    tolerations: []
  matching:
    nodeSelector: null
    tolerations: []
  worker:
    nodeSelector: null
    tolerations: []
  admintools:
    nodeSelector: null
    tolerations: []
  web:
    nodeSelector: null
    tolerations: []

metastore:
  Metastore:
    postgresql:
      postgresqlUsername: 
      postgresqlDatabase: meta
      postgresqlHost: 
      postgresqlPort: 5432
    storageaccount:
      azureaccountname: 
      azureblobstoragekey: 
      azurecontainer: metastore

# TCM
TCM:
  enabled: false
  DB_HOST: 
  DB_NAME: tcm
  DB_USER: tcm
  DB_PWD: 

# otel-collector
otel-collector:
  enabled: true
  namespaceOverride: "{{ .Values.namespace }}"
  config:
    endpoint: "http://loki-{{ .Values.namespace }}-gateway.{{ .Values.namespace }}.svc.cluster.local/otlp"
    phoenixendpoint: "phoenix-grpc.{{ .Values.namespace }}.svc.cluster.local:4417"

# Loki Configuration
loki:
  enabled: true
  fullnameOverride: "loki-{{ .Values.namespace }}"
  loki:
    namespaceOverride: "{{ .Values.namespace }}"
    auth_enabled: false
    schemaConfig:
      configs:
        - from: "2024-04-01"
          store: tsdb
          object_store: azure
          schema: v13
          index:
            prefix: loki_index_
            period: 24h
    ingester:
      chunk_encoding: snappy
    tracing:
      enabled: true
    querier:
      max_concurrent: 4

    limits_config:
      otlp_config:
        resource_attributes:
          attributes_config:
            - action: index_label
              regex: service.group
      allow_structured_metadata: true
      volume_enabled: true
      retention_period: 672h # 28 days retention
    storage:
      type: azure
      azure:
        container_name: loki-container
        useManagedIdentity: false
        useFederatedToken: false
        endpointSuffix: core.windows.net
      tsdb_shipper:
        active_index_directory: /loki/index
        cache_location: /loki/index_cache
        cache_ttl: 24h
      filesystem:
        directory: /loki/chunks
      bucketNames:
        chunks: "chunks"
        ruler: "ruler"
        admin: "admin"

  gateway:
    basicAuth:
      enabled: false
      username: null
      password: null
      existingSecret: null

  deploymentMode: SimpleScalable

  backend:
    replicas: 3
  read:
    replicas: 3
  write:
    replicas: 3

  minio:
    enabled: false

# Promtail Configuration
promtail:
  fullnameOverride: "promtail-{{ .Values.namespace }}"
  loki:
    serviceName: "loki-{{ .Values.namespace }}-gateway"
    servicePort: "80"
  config:
    clients:
      - url: "http://loki-{{ .Values.namespace }}-gateway.{{ .Values.namespace }}.svc.cluster.local/loki/api/v1/push"
        tenant_id: "self-{{ .Values.namespace }}"
    server:
      log_level: "info"
    snippets:
      extraRelabelConfigs:
        - action: keep
          source_labels:
            - __meta_kubernetes_namespace
          regex: ${MONITORING_NAMESPACE}
        - action: replace
          source_labels:
            - __meta_kubernetes_namespace
          target_label: namespace
  kubernetesPodLogs:
    enabled: true

# Grafana Configuration
grafana:
  namespaceOverride: "{{ .Values.namespace }}"

  global:
    imagePullSecrets:
      - name: regcred   
 
  # Disable inline provisioning so we use our own ConfigMap/Secret
  grafana.ini: {}
  datasources: {}

# Spark Operator Configuration
sparkoperator:
  sparkJobNamespace: "{{ .Values.namespace }}"
  spark:
    jobNamespaces:
      - "{{ .Values.namespace }}"
      
