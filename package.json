{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "size:check": "bash scripts/ci/check-repo-size.sh .",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck true --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "docker:backend": "yarn install --immutable && yarn build:backend && DOCKER_BUILDKIT=1 docker build --file docker/Dockerfile.backend -t platform_cloudhub-backend:latest .",
    "docker:backend:clean": "rm -rf packages/backend/dist && yarn docker:backend",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "bash scripts/ci/lint-all-wrapper.sh",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*",
    "services/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@backstage/cli-defaults": "^0.1.6",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@jest/environment-jsdom-abstract": "^30.0.0",
    "@mui/icons-material": "^5.0.0",
    "@mui/material": "^5.18.0",
    "@mui/styles": "^5.18.0",
    "@playwright/test": "^1.32.3",
    "@testing-library/dom": "^10.1.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.25.0",
    "jest": "^30.2.0",
    "jest-runtime": "^30.4.2",
    "jsdom": "^27.1.0",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "5.8.3"
  },
  "resolutions": {
    "@backstage/cli-module-build@npm:^0.1.3": "patch:@backstage/cli-module-build@npm%3A0.1.3#~/.yarn/patches/@backstage-cli-module-build-npm-0.1.3-a54420dfac.patch",
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
