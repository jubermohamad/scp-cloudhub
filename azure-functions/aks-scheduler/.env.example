# Azure Function — AKS Scheduler

# ── Required ─────────────────────────────────────────────────────────────────

# Backstage backend URL (without trailing slash).
# The function will call GET /api/cost-automation/azure/aks/schedules
# and GET /api/cost-automation/azure/aks/managed from this base.
BACKSTAGE_URL=https://backstage.yourplatform.example.com

# (Optional) API key or bearer token if your Backstage instance requires auth.
# Set this if you have not opened the cost-automation API to unauthenticated access.
# BACKSTAGE_API_TOKEN=

# ── Azure credentials ────────────────────────────────────────────────────────
# Required in every environment. Use the CloudHub platform service principal.
# AZURE_TENANT_ID=d0fec9dd-9219-4514-a1d8-1a872244bf6e
# AZURE_CLIENT_ID=73b2043b-6230-480a-8a9a-fd37f68af1b2
# AZURE_CLIENT_SECRET=

# ── Execution tuning ──────────────────────────────────────────────────────────

# Number of minutes on either side of the scheduled time that still trigger
# an execution. Defaults to 4 (suitable for a 5-minute timer trigger).
# SCHEDULE_WINDOW_MINUTES=4
