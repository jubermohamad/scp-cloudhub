<dbspec name="AlertFeedback" comments="Alerts from V_SM_ALERTS">

    <!-- Read Alerts data from ALERT_HEADER table -->
    <source-query>
	SELECT *
	FROM (
		SELECT 
		   ALERT_ID as AlertId,
		   RUN_DATE as RunDate,
		   ACCOUNT_ID as AccountID,
		   CUSTOMER_ID as CustomerID,
		   CUSTOMER_SEGMENT as CustomerSegment,
		   ORGANISATIONAL_UNIT as OrganisationalUnit,
		   CHECK_NAME as CheckName,
		   ALERT_WEIGHT as AlertWeight,
		   ALERT_INFO  as AlertInfo
		 FROM V_SM_ALERTS
	 ) V_SM_ALERTS	 
	 WHERE @WHERE@
    </source-query>
    <tablename> V_SM_ALERTS  </tablename>
    <!--bad-tablename>NONE</bad-tablename-->

    <!-- Source Limit Fields  -->
    <!-- Not Supported
	<limit-field name="RunDate"     operator="between"/>
    -->
	<!--limit-field name="RunDate" operator="equals"/-->

    <!-- Navigation Fields -->
    <timefield>RunDate</timefield>
    <!--timefieldIncludeTime>false</timefieldIncludeTime-->
    <!-- Not Supported
	<keyfield>AlertId</keyfield>
 	--> 
	<column fieldname="RunDate" dataType="DATE" columnname="RunDate"/>
