# Azure AKS target managed by Platform Engineering for CloudHub Developer Workspaces.
# These values are required before workspace creation can provision Kubernetes resources.
# Do not put credentials, kubeconfig data, or client secrets in this file.
CLOUDHUB_WORKSPACE_AKS_SUBSCRIPTION_ID=
CLOUDHUB_WORKSPACE_AKS_RESOURCE_GROUP=
CLOUDHUB_WORKSPACE_AKS_CLUSTER_NAME=
CLOUDHUB_WORKSPACE_NAMESPACE=cloudhub-workspaces

# Terraform Cloud + GitHub runtime credentials for production-grade
# infrastructure provisioning (Azure foundation resources + test VMs).
# Keep real values in secure secret stores, not in source control.
CLOUDHUB_TFC_TOKEN=
CLOUDHUB_TFC_VCS_OAUTH_TOKEN_ID=
CLOUDHUB_TFC_PROJECT_ID=
GITHUB_ACTIONS_TOKEN=
# Optional alias for local/dev shells when GITHUB_ACTIONS_TOKEN is not used.
CLOUDHUB_GITHUB_TOKEN=

# Deployment Portal pipeline integration.
# Defaults to SymphonyFS/pipeline-internal and its deploy/diff workflow contracts.
# The GitHub token above needs repository read and Actions workflow-dispatch
# write access to the selected repository.
SYMPHONYFS_SCRIPTS_REPOSITORY=SymphonyFS/pipeline-internal
SYMPHONYFS_WORKFLOW_ID=deploy-with-dynamic-runners.yml
SYMPHONYFS_DIFF_WORKFLOW_ID=github-actions-diff-manual.yml
SYMPHONYFS_WORKFLOW_REF=main

# Optional automated Cloudflare DNS for Deployment Portal deploys.
# Token requires DNS edit permissions for symphonyai.dev and symphonyai.cloud.
# If zone-list access is not granted, pin both zone IDs. If the token is unset,
# DNS is logged as SKIPPED; deployments may continue using externally managed DNS.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID_SYMPHONYAI_DEV=
CLOUDFLARE_ZONE_ID_SYMPHONYAI_CLOUD=
# Required whenever CLOUDFLARE_API_TOKEN is set: map exact instance-helmfile
# kubeContext names to actual ingress IPv4 addresses supplied by Platform Eng.
# Example shape only: {"uk-eng-dev":"<actual-ingress-ip>"}
CLOUDHUB_CLUSTER_INGRESS_IPS=

# Terraform Cloud Repository Configuration
# The repository must be accessible by the OAuth token configured above.
# If you get "Repository doesn't exist or isn't accessible" errors:
# 1. Ensure the repository is connected to Terraform Cloud's VCS provider
# 2. Verify the OAuth token has access to the repository
# 3. Set this to an organization repository accessible by your OAuth token
# 4. See docs/GPU_TFC_TROUBLESHOOTING.md for detailed troubleshooting
CLOUDHUB_TFC_REPOSITORY=jubermohamad/platform_cloudhub
CLOUDHUB_TFC_BRANCH=main
CLOUDHUB_TFC_WORKING_DIRECTORY=infra/gpu-self-service

# CloudHub user sign-in configuration. These credentials are only for the
# Microsoft OAuth provider; Azure platform SDKs use AZURE_* below.
# Keep credentials out of source control.
# The Docker app defaults to Microsoft auth; guest auth is only for local testing and should remain false unless you intentionally want it.
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_TENANT_ID=
AUTH_MICROSOFT_CALLBACK_URL=http://localhost:7007/api/auth/microsoft/handler/frame
# Sign-in is restricted to members of cloudhub-login-allow. Verified members of
# CloudHubPlatformOwners receive the CloudHub platform-admin role.
CLOUDHUB_LOGIN_ALLOW_GROUP_ID=7cb52fd1-0e7d-4722-abab-35de25f99ec2
CLOUDHUB_PLATFORM_OWNERS_GROUP_ID=9d54f155-828d-4a05-8992-a05996f806ef
# Verified Data Export Hub access group (members receive platform-admin access).
CLOUDHUB_DATA_EXPORT_GROUP_ID=ea5a79c7-5b88-4108-9c2e-9e88bffff673
# Sole CloudHub Azure platform identity. It must be the platform SPN and have
# the required Azure RBAC plus Graph application permissions where applicable.
AZURE_TENANT_ID=d0fec9dd-9219-4514-a1d8-1a872244bf6e
AZURE_CLIENT_ID=73b2043b-6230-480a-8a9a-fd37f68af1b2
AZURE_CLIENT_SECRET=
CLOUDHUB_ENABLE_GUEST_AUTH=false

# CloudHub 1Password provisioning workflow routing.
# Keep this path inside this repository to avoid external repo dependencies.
CLOUDHUB_1PASSWORD_WORKFLOW_REPOSITORY=jubermohamad/platform_cloudhub
CLOUDHUB_1PASSWORD_WORKFLOW_ID=copy-1password-section.yml
CLOUDHUB_1PASSWORD_WORKFLOW_REF=main
CLOUDHUB_1PASSWORD_WRITE_SECRET_NAME=CLOUDHUB_GITHUB_RUNNER_WRITE

# Tailscale jumpbox access provisioning.
# These values point the backend at the policy repo that owns Tailscale group
# membership and allow CloudHub to open the PR used to grant jumpbox access.
TAILSCALE_REPO_OWNER=SymphonyFS
TAILSCALE_REPO=tailscale
TAILSCALE_BASE_BRANCH=main
TAILSCALE_POLICY_PATH=policy.hujson

# AKS execution tracking and submission preflight (read-only).
# Tracking reads PRs, reviews and checks on scp-infra-as-code and Terraform Cloud
# runs/workspaces/outputs; it never writes. Both tokens are required for
# tracking and must differ from the write tokens (GITHUB_ACTIONS_TOKEN /
# GITHUB_TOKEN, CLOUDHUB_TFC_TOKEN); an identical value is refused. The GitHub
# token needs read access to SymphonySensa/scp-infra-as-code (contents, pull
# requests, checks). The TFC token must be read-only:
# read runs + read state outputs on workspace `workspacemanager` and projects
# SCP-DEV-AKS / SCP-PRD-AKS (org sensa-cloud-platform).
CLOUDHUB_AKS_GITHUB_READ_TOKEN=
CLOUDHUB_AKS_TFC_READ_TOKEN=
# Azure address-space (Resource Graph) and compute quota checks use the
# canonical AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET above.
# The platform SP needs Reader access across subscriptions with VNets (ideally
# at the tenant root management group) and subscription b0799078-b42a-4b59-9e70-22cd09a20ee2.
# Unset credentials => those checks are "unverified" and submission is blocked.
CLOUDHUB_AKS_AZURE_MANAGEMENT_GROUP=

# Preferred CloudHub network profile configuration for VM provisioning, and the
# approved-VNet allow-list for GPU Compute. An object keyed by profile name.
# Every field is mandatory — a profile missing one fails parsing at startup.
#
# GPU Compute selects profiles by name prefix: gpu-<sku>* for the SKU the user
# picked (gpu-a100*, gpu-h100*), falling back to generic gpu* if no SKU-specific
# profile exists. Leaving this empty means the "Approved VNet" dropdown on the
# Create GPU Instance page is empty and creation cannot proceed.
# See docs/gpu-compute-network-onboarding.md.
#
# Must be a SINGLE line and SINGLE-quoted — scripts/bootstrap_cloudhub.sh sources
# this file with bash, which would otherwise strip the JSON's double quotes.
# Example (shown expanded for readability; collapse to one line in your .env):
# {
#   "testvm": {
#     "subscriptionId": "sub-id",
#     "resourceGroup": "rg-network",
#     "vnetName": "vnet-platform",
#     "subnetName": "snet-testvm",
#     "region": "swedencentral"
#   },
#   "gpu-a100-primary": {
#     "subscriptionId": "sub-id",
#     "resourceGroup": "rg-ml",
#     "vnetName": "vnet-ml",
#     "subnetName": "snet-gpu-a100",
#     "region": "swedencentral"
#   }
# }
CLOUDHUB_NETWORKS_JSON=

# Default Azure subscription. GPU Compute also requires this (or
# GPU_AZURE_SUBSCRIPTION_ID) to resolve vCPU-family quota before provisioning;
# without it every GPU quota check fails.
AZURE_SUBSCRIPTION_ID=

# GPU Compute authorization. Fail-closed: unset denies all GPU access.
# GPU_ENTRA_GROUP_ID is the Azure AD *object id* of the allowed group.
# GPU_GRAPH_ENABLED=true resolves membership via Microsoft Graph, which is
# required when sign-in tokens carry no group claims.
GPU_ENTRA_GROUP_ID=
GPU_GRAPH_ENABLED=false

# SRI-Provisional Backend Configuration
# Enable to use SRI-Provisional as an optional deployment backend.
# When enabled, a separate PostgreSQL database 'sri_provisional' is initialized.
# Available deployment backends: cloudhub-native, provisioner-pipeline, sri-provisional
SRI_PROVISIONAL_ENABLED=false
